<%= form_with model: carpool, class: "paper-form" do |form| %>
  <% if carpool.errors.any? %><div class="error-box"><strong>Please check the details:</strong><%= carpool.errors.full_messages.to_sentence %></div><% end %>
  <p class="form-hint">* required</p>
  <div class="field wide"><%= form.label :name, "Trip name *" %><%= form.text_field :name, placeholder: "Beach day", autofocus: true, required: true %></div>
  <% unless signed_in? %>
    <% if @guest_user&.errors&.any? %><div class="error-box"><%= @guest_user.errors.full_messages.to_sentence %></div><% end %>
    <div class="field wide">
      <label for="user_name">Your name *</label>
      <%= text_field_tag "user[name]", params.dig(:user, :name), id: "user_name", required: true %>
    </div>
    <div class="field wide">
      <label for="user_email">Your email *</label>
      <%= email_field_tag "user[email]", params.dig(:user, :email), id: "user_email", required: true %>
    </div>
    <p class="form-hint">No password needed — if your email already has an account, we'll send you a sign-in link and finish creating the carpool from there. Your name and email are visible to carpool participants.</p>
  <% end %>
  <% more = carpool.destination.present? || carpool.starts_at || carpool.return_starts_at || carpool.details.present? || carpool.errors.any? %>
  <details class="more-details" <%= "open" if more %>>
    <summary>Add more details</summary>
    <div class="field wide"><%= form.label :destination, "Destination address (optional)" %><%= form.text_field :destination, placeholder: "123 Great Hwy, San Francisco" %></div>
    <div class="field wide"><%= form.label :starts_at, "Event start time (optional)" %><%= form.datetime_local_field :starts_at %></div>
    <div class="field wide"><%= form.label :return_starts_at, "Return trip starts around (optional)" %><%= form.datetime_local_field :return_starts_at %></div>
    <p class="form-hint">Times are in the event's local time.</p>
    <div class="field wide"><%= form.label :details, "Notes (optional)" %><%= form.text_area :details, rows: 3 %></div>
  </details>
  <div class="form-submit"><%= form.submit carpool.persisted? ? "Save changes" : "Create carpool", class: "button button-primary" %></div>
<% end %>
