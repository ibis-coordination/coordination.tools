<% content_for :title, "coordination.tools" %>
<section class="hero page-shell">
  <h1>Coordination tools</h1>
  <p class="hero-copy">Practical tools for solving common coordination problems.</p>
</section>

<section class="tool-section page-shell" id="tools">
  <h2>Tools</h2>
  <div class="tool-card">
    <div><h3>Carpool organizer</h3><p>List available rides and ride requests.</p></div>
    <%= link_to "Create a carpool", new_carpool_path, class: "button button-primary" %>
  </div>

  <h2 class="planned-heading">Planned tools</h2>
  <div class="tool-card tool-card-planned">
    <div><h3>Schedule availability finder</h3><p>Find times that work for everyone.</p></div>
    <span class="planned-tag">Planned</span>
  </div>
  <div class="tool-card tool-card-planned">
    <div><h3>Volunteer board</h3><p>Post tasks and let people sign up for them.</p></div>
    <span class="planned-tag">Planned</span>
  </div>
  <div class="tool-card tool-card-planned">
    <div><h3>Group decision maker</h3><p>Gather options and converge on a decision together.</p></div>
    <span class="planned-tag">Planned</span>
  </div>
  <div class="tool-card tool-card-planned">
    <div><h3>Conditional commitment tracker</h3><p>Commit together: pledges activate once enough people join.</p></div>
    <span class="planned-tag">Planned</span>
  </div>
</section>
