<%= form_with model: [carpool, ride], namespace: local_assigns[:namespace], class: "ride-form", data: { controller: "ride-form" } do |form| %>
  <%= form.hidden_field :direction %>
  <% if ride.errors.any? %><div class="error-box"><%= ride.errors.full_messages.to_sentence %></div><% end %>
  <div class="role-toggle">
    <label><%= form.radio_button :role, "driver", data: { join_target: "role", ride_form_target: "role", action: "change->ride-form#sync" } %><span>I can drive</span></label>
    <label><%= form.radio_button :role, "rider", data: { join_target: "role", ride_form_target: "role", action: "change->ride-form#sync" } %><span>I need a ride</span></label>
  </div>
  <p class="form-hint">* required</p>
  <div class="form-grid">
    <div class="field">
      <%= form.label :origin, ride.direction == "return" ? "Destination *" : "Starting location *" %>
      <%= form.text_field :origin, placeholder: ride.direction == "return" ? "Home address or area" : "The Mission", required: true %>
    </div>
    <div class="field"><%= form.label :departure_time, "Departure time (optional)" %><%= form.datetime_local_field :departure_time %></div>
    <div class="field">
      <%= form.label :seats, ride.driver? ? "Seats you can offer *" : "Seats you need *",
            data: { ride_form_target: "seatsLabel", driver_text: "Seats you can offer *", rider_text: "Seats you need *" } %>
      <%= form.number_field :seats, min: 1, max: 12, required: true %>
    </div>
    <div class="field wide"><%= form.label :notes, "Notes (optional)" %><%= form.text_area :notes, rows: 2, placeholder: "I can pick up along the way…" %></div>
  </div>
  <%= form.submit ride.persisted? ? "Save changes" : "Add entry", class: "button button-primary" %>
<% end %>
