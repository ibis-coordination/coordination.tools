<article class="ride-card">
  <div class="ride-main">
    <div class="ride-top"><h3><%= ride.user.name %></h3><span><%= ride.driver? ? "#{pluralize(ride.available_seats, "seat")} available" : "needs #{pluralize(ride.seats, "seat")}" %></span></div>
    <p class="route"><span><%= ride.direction == "return" ? "Destination:" : "Starting location:" %></span> <%= ride.origin.presence || "not set — ask #{ride.user.name}" %></p>
    <% if ride.departure_time %>
      <% event_date = (ride.direction == "return" ? @carpool.return_starts_at : @carpool.starts_at)&.to_date %>
      <p class="meta">Departure time: <%= ride.departure_time.strftime(ride.departure_time.to_date == event_date ? "%-I:%M %p" : "%b %-d, %-I:%M %p") %></p>
    <% end %>
    <% if ride.notes.present? %><p class="notes"><%= ride.notes %></p><% end %>
    <% if signed_in? %><p class="contact">Contact: <%= mail_to ride.user.email %></p><% end %>
    <% if ride.driver? %>
      <% if ride.ride_claims.any? %>
        <div class="passengers">
          <strong>Passengers</strong>
          <ul>
            <% ride.ride_claims.each do |claim| %>
              <li>
                <span><%= claim.user.name %> — <%= pluralize(claim.seats, "seat") %><% if claim.pickup_location.present? %> — <%= claim.pickup_location %><% end %><% if signed_in? %> — <%= mail_to claim.user.email %><% end %></span>
                <% if current_user == claim.user %>
                  <%= button_to "Leave ride", carpool_ride_ride_claim_path(@carpool, ride, claim), method: :delete, form: { data: { turbo_confirm: "Leave this ride? We'll add a ride request for you so drivers know you still need a seat — you can remove it afterward." } } %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% unless @your_rides[ride.direction]&.driver? || current_claim&.ride_id == ride.id || !signed_in? %>
        <% if !ride.available_seats.positive? %>
          <p class="full-label">This ride is full.</p>
        <% else %>
          <% failed_claim = (@ride_claim if @claim_ride == ride) %>
          <% prefill = current_claim || @your_rides[ride.direction] %>
          <% claim = failed_claim || ride.ride_claims.new(
               pickup_location: prefill.is_a?(RideClaim) ? prefill.pickup_location : prefill&.origin,
               seats: [ prefill&.seats || 1, ride.available_seats ].min) %>
          <details class="claim-details" id="claim-details-<%= ride.id %>" data-turbo-permanent <%= "open" if failed_claim %>>
            <summary><%= current_claim ? "Switch to this ride" : "Join this ride" %></summary>
            <%= render "ride_claims/form", carpool: @carpool, ride: ride, ride_claim: claim, switching: current_claim.present? %>
          </details>
        <% end %>
      <% end %>
    <% elsif signed_in? && current_user != ride.user && (my_drive = @your_rides[ride.direction])&.driver? %>
      <% if my_drive.available_seats >= ride.seats %>
        <%= button_to "Pick up #{ride.user.name}", carpool_pickups_path(@carpool), params: { ride_id: ride.id }, class: "button button-primary pickup-button", form: { data: { turbo_confirm: "Add #{ride.user.name} to your ride (#{pluralize(ride.seats, "seat")}, from #{ride.origin})? We'll email them the news." } } %>
      <% else %>
        <p class="full-label">Not enough free seats in your ride.</p>
      <% end %>
    <% end %>
    <% if current_user == ride.user %>
      <% removal_warning = ride.driver? && ride.ride_claims.any? ? "Remove this ride? #{pluralize(ride.ride_claims.size, "passenger")} will be moved to ride requests." : "Remove your entry?" %>
      <div class="owner-actions"><%= link_to "Edit", edit_carpool_ride_path(@carpool, ride) %><%= button_to "Remove", carpool_ride_path(@carpool, ride), method: :delete, form: { data: { turbo_confirm: removal_warning } } %></div>
    <% end %>
  </div>
</article>
