<% content_for :title, "Sign in — coordination.tools" %>
<section class="page-shell form-page narrow">
  <h1>Sign in</h1>
  <p>Enter your name and email. New emails are signed in right away — no password needed. If the email already has an account, we'll send it a sign-in link.</p>
  <%= form_with model: @user, url: session_path, class: "paper-form" do |form| %>
    <% if @user.errors.any? %><div class="error-box"><%= @user.errors.full_messages.to_sentence %></div><% end %>
    <div class="field"><%= form.label :name %><%= form.text_field :name, required: true, autofocus: true %></div>
    <div class="field"><%= form.label :email %><%= form.email_field :email, required: true %></div>
    <%= form.submit "Continue", class: "button button-primary" %>
  <% end %>
</section>
