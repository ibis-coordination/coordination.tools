# Copy this file to .kamal/secrets and fill in real values.
# .kamal/secrets is gitignored — real secrets never get committed.
#
# Lines support $(command) substitution and $VAR interpolation, so you can
# also pull values from a password manager (see kamal-deploy.org/docs/commands/secrets).

# GitHub personal access token with read:packages + write:packages,
# used to push/pull the image at ghcr.io.
KAMAL_REGISTRY_PASSWORD=ghp_...

# Rails credentials key — read from the local file, do not paste it here.
RAILS_MASTER_KEY=$(cat config/master.key)

# Postgres password. Pick one long random value; the three names below
# must all resolve to it (app connection, postgres container, pg_dump).
COORDINATION_TOOLS_DATABASE_PASSWORD=change-me
POSTGRES_PASSWORD=$COORDINATION_TOOLS_DATABASE_PASSWORD
PGPASSWORD=$COORDINATION_TOOLS_DATABASE_PASSWORD

# Resend API key for magic-link email (https://resend.com).
RESEND_API_KEY=re_...

# DigitalOcean Spaces backup target and access key pair for nightly
# database backups. The endpoint region must match the bucket's region.
SPACES_BUCKET=your-bucket-name
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=DO...
AWS_SECRET_ACCESS_KEY=...
